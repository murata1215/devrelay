# DevRelay Server 設定ファイル
#
# 実キー一覧は CLAUDE.md の「環境変数」節も参照。
# 社内オンプレ移設の詳細手順は doc/onprem-windows-setup-guide.md を参照。

# ============================================================
# Database（必須）
# ============================================================
DATABASE_URL="postgresql://user:password@localhost:5432/devrelay"

# ============================================================
# Server（必須）
# ============================================================
PORT=3000
HOST=0.0.0.0

# サーバーの公開 URL（MCP の OAuth メタデータ・issuer に使用。未設定時は https://app.devrelay.io）
# 社内で MCP を使わないなら未設定のままでよい
# PUBLIC_URL=https://devrelay.corp.example

# ============================================================
# 秘密情報の暗号化（必須・新規環境では必ず独自値を生成すること）
# ============================================================
# UserSettings に保存される API キー・Bot トークン類（OpenAI/Anthropic/Gemini/Discord/Telegram）の
# 暗号化に使う鍵。未設定時はリポジトリに書かれた公開デフォルト値にフォールバックし、
# 起動時に警告が出る。
#
# 生成例: openssl rand -hex 32
#
# ⚠️ 稼働中の環境に後から設定・変更すると、既存の暗号化済み設定が復号不能になる
#    （API キー等が消える）。新規構築時に一度だけ決めて、以後変更しないこと。
SETTINGS_ENCRYPTION_KEY=

# ============================================================
# 社内プロキシ対応（社内オンプレ移設・プロキシ経由でのみ外部に出られる環境で設定）
# ============================================================
# 設定すると OpenAI/Anthropic/Gemini SDK・Google OAuth 等の外向き HTTPS 通信がこのプロキシ経由になる。
# 未設定なら何もしない（VPS 環境ではそのままでよい）。
# HTTPS_PROXY=http://proxy.corp.example:8080
# NO_PROXY=localhost,127.0.0.1

# ============================================================
# システム管理者（サービス再起動・DevRelay Sites 等の管理者限定機能に必要）
# ============================================================
# カンマ区切りのメールアドレス
DEVRELAY_SYSTEM_ADMIN_EMAILS=

# サービス再起動・ステータス確認コマンド（既定は pm2。Windows など pm2 を使わない環境で上書き）
# DEVRELAY_SERVICE_RESTART_CMD=nssm restart DevRelayServer
# DEVRELAY_SERVICE_STATUS_CMD=sc query DevRelayServer

# ============================================================
# Discord Bot（任意・社内オンプレでは通常未使用）
# ============================================================
# DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ============================================================
# Telegram Bot（任意・社内オンプレでは通常未使用）
# ============================================================
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================================
# Google OAuth ログイン（任意）
# ============================================================
# 社内ドメインでは Google 側が公開 TLD の HTTPS リダイレクト URI を要求するため使用不可。
# 社内では /api/auth/register・/api/auth/login のローカル認証（email+password）を使うこと。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ============================================================
# Web Push 通知（任意・VAPID）
# ============================================================
# 生成: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ============================================================
# Firebase Cloud Messaging（任意・モバイルアプリのプッシュ通知用）
# ============================================================
# サービスアカウント JSON へのローカルパス（リポジトリにコミットしないこと）
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ============================================================
# AI API キー（自然言語コマンド解析・会話要約等。ユーザーごとの設定でも上書き可）
# ============================================================
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ドキュメント検索の embedding 生成にも OPENAI_API_KEY が使われる（pgvector 必須）

# ============================================================
# キルスイッチ（既定値は CLAUDE.md 参照。'0' で無効化）
# ============================================================
# DEVRELAY_PLAN_STRICT_CHAT=1
# DEVRELAY_THREADS_HIDE_EMPTY_ENDED=1
# DEVRELAY_SITES_HEALTH=1
# DEVRELAY_SITES_ACCESS_LOG=1
# DEVRELAY_MCP_ASK=1
# DEVRELAY_MCP_ANSWER_RAW=0

# 社内オンプレでは testflight（*.devrelay.io + Caddy + sudo 前提）を使わないため無効化を推奨
# DEVRELAY_TESTFLIGHT=1

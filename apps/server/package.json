{
  "name": "@devrelay/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "start": "node dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:bootstrap": "prisma db push && node -e \"const{execSync}=require('child_process');const fs=require('fs');const sql=fs.readFileSync('prisma/bootstrap.sql','utf8');execSync('npx prisma db execute --stdin',{input:sql,stdio:['pipe','inherit','inherit']})\"",
    "setup:service": "./scripts/setup-service.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@devrelay/shared": "workspace:*",
    "@fastify/cors": "^8.5.0",
    "@fastify/websocket": "^8.3.1",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.8.0",
    "@types/archiver": "^6.0.4",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.0",
    "firebase-admin": "^13.7.0",
    "nanoid": "^5.0.4",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.16.0",
    "undici": "^6.21.3",
    "web-push": "^3.6.7",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.10.0",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.10",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}

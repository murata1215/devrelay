// DevRelay Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ユーザー
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  passwordHash  String?   // メール/パスワード認証用
  name          String?   // 表示名
  googleId      String?   @unique // Google OAuth 用
  apiKey        String?   // Anthropic API Key (encrypted)
  plan          String    @default("free") // free, pro, team
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  machines            Machine[]
  sessions            Session[]
  platformLinks       PlatformLink[]
  settings            UserSettings[]
  authSessions        AuthSession[]
  buildLogs           BuildLog[]
  devReports          DevReport[]
  testflightServices  TestflightService[]
  teams               Team[]
  notifications       Notification[]
  organizationMember  OrganizationMember? // 所属組織（エンタープライズモード、1ユーザー1組織）
  managerAssignments      ManagerAssignment[] @relation("ManagerToMembers") // 自分が manager として担当するユーザー
  managedBy               ManagerAssignment[] @relation("MemberToManagers") // 自分を担当する manager
  personalAccessTokens    PersonalAccessToken[] // MCP 用 Personal Access Token
}

// 組織（エンタープライズモード）
model Organization {
  id               String   @id @default(cuid())
  orgCode          String   @unique   // 組織ID（システム自動発行、例: ORG-7K3M9Q）
  name             String              // 会社名
  joinPasswordHash String              // 参加パスワード（bcrypt ハッシュ）
  logo             Bytes?              // 会社ロゴ（PostgreSQL bytea）
  logoMimeType     String?             // ロゴの MIME タイプ（image/png 等）
  allowedIpRanges  String?             // IP アクセス制限（#285）: 許可 CIDR の JSON 配列文字列。null/空配列=制限なし
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members          OrganizationMember[]
  managerAssignments ManagerAssignment[]
}

// 組織メンバー（userId unique = 1ユーザー1組織）
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // 'admin' | 'manager' | 'member'
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// マネージャー担当割当（manager ⇔ user の多対多、統制 v2 #268）
// member は自分を担当する manager が1人以上いないとコマンド発行不可
model ManagerAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerUserId  String       // 監督する側（role: manager または admin）
  manager        User         @relation("ManagerToMembers", fields: [managerUserId], references: [id], onDelete: Cascade)
  memberUserId   String       // 監督される側（role: member）
  member         User         @relation("MemberToManagers", fields: [memberUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([managerUserId, memberUserId])
  @@index([memberUserId])
  @@index([managerUserId])
  @@index([organizationId])
}

// WebUI 認証セッション
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Personal Access Token（MCP 用の長期トークン、#271）
model PersonalAccessToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    // ユーザーが付けるトークン名（例: "CI/CD", "自動化スクリプト"）
  tokenHash  String    @unique // SHA-256 ハッシュ（平文は保存しない）
  lastUsedAt DateTime? // 最終使用日時
  revokedAt  DateTime? // 失効日時（null=有効）
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// プラットフォーム連携
model PlatformLink {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  platform             String    // discord, telegram, line, slack
  platformUserId       String    // プラットフォーム側のユーザーID
  platformName         String?   // プラットフォーム側のユーザー名（Discord username など）
  chatId               String?   // DMのチャットID
  lastProjectId        String?   // 前回接続したプロジェクト（継続用）
  lastMentionMessageId String?   // 前回メンションしたメッセージID（過去メッセージ取得用）
  lastMentionAt        DateTime? // 前回メンション日時
  linkedAt             DateTime? // リンクコードでリンクされた日時
  createdAt            DateTime  @default(now())

  @@unique([platform, platformUserId])
}

// プラットフォームリンクコード（一時的な認証コード）
model PlatformLinkCode {
  id             String   @id @default(cuid())
  code           String   @unique  // 6桁コード (例: ABC123)
  platform       String   // discord, telegram
  platformUserId String   // プラットフォーム側のユーザーID
  platformName   String?  // Discord username など
  chatId         String?  // 返信用チャットID
  expiresAt      DateTime // 5分後
  createdAt      DateTime @default(now())
}

// マシン
model Machine {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  name           String
  displayName    String?   // ユーザーが設定した表示名（ホスト名エイリアスから自動計算）
  token          String    @unique // 接続トークン
  status         String    @default("offline") // online, offline
  lastSeenAt     DateTime?
  managementInfo Json?     // Agent の管理コマンド情報（OS・パス固有）
  projectsDirs   Json?     // Server 管理のプロジェクト検索パス（string[]）
  skipPermissions Boolean  @default(false) // 全ツール自動許可（--dangerously-skip-permissions 相当）
  disableAsk      Boolean  @default(false) // AskUserQuestion 無効化（SDK disallowedTools で除去）
  // #296: 自動更新（サーバー主導）。既定 ON。失敗が続いたマシンは自動で false に落とす
  autoUpdate           Boolean   @default(true)  // 自動更新の有効/無効（マシン単位）
  lastAutoUpdateAt     DateTime?                 // 直近に自動更新を試みた日時
  lastAutoUpdateCommit String?                   // 直近に狙ったリモートコミット
  lastAutoUpdateStatus String?                   // success / failed:stale-dist / error:<msg>
  autoUpdateAttempts   Int       @default(0)     // 同一コミットへの試行回数（成功でリセット）
  // #299: バージョン更新状態の表示用（version-check 応答を永続化。u コマンドの日時と同じ）
  localCommit      String?   // 現在の Agent 側 HEAD コミット
  localCommitDate  DateTime? // そのコミット日時（u の「ローカル」日時）
  remoteCommit     String?   // origin の最新コミット
  remoteCommitDate DateTime? // そのコミット日時（u の「リモート」日時）
  versionCheckedAt DateTime? // 最後に version-check 応答を受けた時刻
  // #302: 実行中コードの鮮度（stale dist 検知・可視化用。旧 Agent は送ってこないため null=判定不能）
  runningCodeMtime DateTime? // 実行中エントリファイル(process.argv[1])の mtime
  runningCodeStale Boolean?  // 実行中コードが localCommit より古い＝再ビルド漏れ。null=旧 Agent で判定不能
  // Claude ログイン切れ検知（リモート再ログイン中継 Phase1）。旧 Agent は送ってこないため null=判定不能
  claudeAuthOk        Boolean?  // true=ログイン済み / false=切れている / null=未確認
  claudeAuthCheckedAt DateTime? // 直近のチェック時刻
  claudeAuthAccount   String?   // ログイン中アカウントのメールアドレス（判明時のみ）
  deletedAt      DateTime? // ソフトデリート（null = アクティブ）
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projects       Project[]
  sessions       Session[]
  buildLogs      BuildLog[]
  documents      AgentDocument[]
  toolApprovals  ToolApproval[]

  @@unique([userId, name])
}

// プロジェクト
model Project {
  id           String    @id @default(cuid())
  machineId    String
  machine      Machine   @relation(fields: [machineId], references: [id])
  name         String
  displayName  String?   // ユーザーが設定する表示名（null なら name を使用）
  path         String
  defaultAi    String    @default("claude")
  description  String?
  lastUsedAt   DateTime?
  terminalMode Boolean   @default(false)  // 端末インタフェースモード（PTY 経由で claude 起動）。新規プロジェクトはデフォルト無効
  createdAt    DateTime  @default(now())
  deletedAt    DateTime? // ソフトデリート（#322）。Agent が projects.yaml で送ってこなくなったプロジェクトを非表示化。再出現で自動復活（null に戻る）

  sessions       Session[]
  buildLogs      BuildLog[]
  teamMembers    TeamMember[]
  toolApprovals  ToolApproval[]
  notifications  Notification[]

  @@unique([machineId, name])
}

// チーム（クロスプロジェクトクエリ用）
// 名前付きのプロジェクトグループ。同じチーム内のプロジェクトは互いに質問可能
model Team {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]

  @@unique([userId, name])
}

// チームメンバー（チームとプロジェクトの関連）
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  @@unique([teamId, projectId])
}

// セッション
model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  machineId     String
  machine       Machine   @relation(fields: [machineId], references: [id])
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  aiTool        String    @default("claude")
  status        String    @default("active") // active, ended
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  summary       String?   // AI 活動要約（統制 v3 #270、閲覧者のキーで生成しキャッシュ）
  summarizedAt  DateTime? // 要約生成日時
  councilMode   Boolean   @default(false) // council mode opt-in（#331。エンジンは未実装、受理の記録のみ）
  approvalNote  String?   // approve_implementation の note（#331。監査用）

  messages       Message[]
  buildLogs      BuildLog[]
  toolApprovals  ToolApproval[]
}

// 監視監査ログ（統制 v3 #270）
// admin/manager が member の会話履歴を閲覧・要約した操作を記録する。
// ユーザー削除後も監査証跡として残すため FK は張らない。
model SupervisionAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  viewerUserId   String   // 閲覧した admin/manager
  targetUserId   String   // 閲覧された member
  action         String   // 'view_sessions' | 'view_messages' | 'summarize'
  detail         String?  // sessionId や検索クエリ等の補足（JSON 文字列）
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([targetUserId])
}

// メッセージ履歴
model Message {
  id          String        @id @default(cuid())
  sessionId   String
  session     Session       @relation(fields: [sessionId], references: [id])
  role        String        // user, ai, system
  content     String
  platform    String        // どのプラットフォームから送信されたか
  usageData          Json?         // AI 実行時の使用量データ（usage, modelUsage, durationMs）
  sourceProjectName  String?       // クロスプロジェクトクエリの送信元プロジェクト名
  createdAt          DateTime      @default(now())
  files              MessageFile[] // 添付ファイル（入力 or 出力）

  @@index([sessionId, createdAt]) // MCP get_conversation_history 用（#272）
}

// メッセージに紐づくファイル（BLOB 保存 + ベクトル検索）
model MessageFile {
  id              String   @id @default(cuid())
  messageId       String
  message         Message  @relation(fields: [messageId], references: [id])
  filename        String
  mimeType        String
  size            Int
  content         Bytes    // ファイル本体（PostgreSQL bytea）
  direction       String   // 'input' | 'output'
  textContent     String?  // テキスト抽出結果（embedding 生成元）
  embeddingStatus String   @default("none") // 'none' | 'processing' | 'done' | 'failed' | 'skipped'
  // embedding vector(1536) は raw SQL で追加（Prisma 非対応型）
  createdAt       DateTime @default(now())

  @@index([messageId])
}

// ユーザー設定（汎用的なKey-Value形式）
model UserSettings {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String   // 設定キー（例: openai_api_key, theme, language など）
  value     String   // 設定値（暗号化が必要な場合は暗号化して保存）
  encrypted Boolean  @default(false) // 暗号化されているかどうか
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// チャンネルセッション（チャンネルごとの前回接続先を記録）
model ChannelSession {
  id               String    @id @default(cuid())
  platform         String    // discord, telegram, line
  chatId           String    // チャンネルID（Discord: channel.id, Telegram: chat.id, LINE: groupId/roomId/userId）
  lastProjectId    String?   // 前回接続したプロジェクトID
  currentSessionId String?   // 現在のセッションID（サーバー再起動後に復元用）
  currentMachineId String?   // 現在のマシンID（サーバー再起動後に復元用）
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([platform, chatId])
}

// ビルドログ（exec 実行の記録）
// プロジェクト名ごとにビルド番号を連番で採番（全マシン共通）
// Agent が「今どのビルドを使ってるか」「最新とどれだけ離れてるか」を追跡
model BuildLog {
  id           String   @id @default(cuid())
  buildNumber  Int      // プロジェクト名ごとの連番ビルド番号（全マシン共通）
  projectName  String   // プロジェクト名（マシン横断で比較するため文字列で保持）
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  machineId    String
  machine      Machine  @relation(fields: [machineId], references: [id])
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  summary      String   // AI 応答先頭部分から自動生成された要約
  prompt       String?  // exec 時のプロンプト（カスタムプロンプトまたはデフォルト）
  createdAt    DateTime @default(now())

  @@unique([projectName, buildNumber])  // プロジェクト名+ビルド番号で一意
  @@index([projectName])                // プロジェクト名での検索用
  @@index([machineId, projectName])     // マシン+プロジェクト名での検索用
}

// テストフライトサービス（試験的サービスの管理）
model TestflightService {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String    @unique  // サービス名（英小文字+数字+ハイフン）
  port        Int       @unique  // 割り当てポート（9001+）
  domain      String    @unique  // <name>.devrelay.io
  directory   String              // /home/devrelay/testflight/<name>
  status      String    @default("placeholder") // placeholder | active | archived
  template    String?             // null=通常, "phaser"=ゲーム, 将来: "react", "nextjs" 等
  gitRepo     String?             // Git リポジトリ URL（設定済みの場合）
  description String?             // サービスの説明
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// エージェントドキュメント（マシンごとのファイル保存、ベクトル検索対応）
model AgentDocument {
  id              String   @id @default(cuid())
  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id])
  filename        String
  mimeType        String
  size            Int
  content         Bytes    // ファイル本体（PostgreSQL bytea）
  textContent     String?  // テキスト抽出結果（embedding 生成元）
  embeddingStatus String   @default("none") // 'none' | 'processing' | 'done' | 'failed' | 'skipped'
  // embedding vector(1536) は raw SQL で追加（Prisma 非対応型）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([machineId])
}

// 開発レポート（会話履歴を AI で要約・構造化した開発記）
model DevReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  projectName String   // プロジェクト名（マシン横断）
  title       String   // レポートタイトル（AI 生成）
  content     Json     // レポート内容（セクション構造 JSON）
  status      String   @default("generating") // generating, completed, failed
  error       String?  // エラーメッセージ（失敗時）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     DevReportEntry[]

  @@index([userId])
  @@index([projectName])
}

// レポートに含まれる会話エントリ（処理済み Message の追跡用）
model DevReportEntry {
  id        String    @id @default(cuid())
  reportId  String
  report    DevReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  messageId String    // AI Message の ID（usageData 付きメッセージ）
  section   Int       // セクション番号（0-indexed）
  createdAt DateTime  @default(now())

  @@unique([reportId, messageId])
  @@index([messageId])
}

// ツール承認履歴（exec モードでの canUseTool の記録）
model ToolApproval {
  id         String    @id @default(cuid())
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id])
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  machineId  String
  machine    Machine   @relation(fields: [machineId], references: [id])
  requestId  String?   @unique  // auto 承認の場合は null
  toolName   String
  toolInput  Json      // ツール引数
  isQuestion Boolean   @default(false) // AskUserQuestion の場合 true（リロード時の復元に使用）
  status     String    // 'pending' | 'allow' | 'deny' | 'auto' | 'timeout'
  createdAt  DateTime  @default(now())
  resolvedAt DateTime? // 承認/拒否された時刻（pending 中は null）

  @@index([projectId, createdAt])
  @@index([sessionId])
}

// プッシュ通知履歴（モバイルアプリの通知一覧・バッジ管理用）
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // 'response' | 'approval' | 'error'
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  projectName String   // 非正規化（表示用、JOIN 不要にするため）
  title       String
  body        String   @default("")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}
